# ========================================================
# EventGenie AI - Environment Configuration Example
# ========================================================

# (Optional) Google Gemini API Key
# If provided, EventGenie AI connects to live Gemini 1.5/2.0 models for chat and plan synthesis.
# If omitted or left blank, the application automatically runs in rich, offline "Demo AI Mode"
# with domain-specific heuristic event planning and recommendations.
GEMINI_API_KEY=

# Local Server Port (Default is 3000)
PORT=3000
